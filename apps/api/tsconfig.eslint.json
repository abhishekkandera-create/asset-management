{
  // Widest view of the package: used by ESLint and by `typecheck`, so test and
  // seed files are checked too. The build uses tsconfig.build.json, which
  // excludes them. rootDir is widened to the package because these files live
  // outside src/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  // The base config excludes test/ and the seed; `exclude` is inherited and
  // filters `include`, so it has to be overridden here or nothing new is seen.
  "exclude": ["node_modules", "dist"],
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "prisma/**/*.ts",
    "vitest.config.ts",
    "vitest.workspace.ts"
  ]
}
