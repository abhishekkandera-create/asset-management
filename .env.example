# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every variable here is validated with Zod at
# startup (apps/api/src/config/env.ts); a missing or malformed one aborts boot.
# ---------------------------------------------------------------------------

# --- Runtime ----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the NestJS API listens on. Managed hosts (Render, Railway, Heroku)
# inject their own PORT, which overrides this automatically.
API_PORT=3000
# Public base URL of the API, used to build Swagger server URLs
API_BASE_URL=http://localhost:3000
# Comma-separated list of origins allowed to call the API from a browser.
# An entry may be an exact origin, a wildcard suffix such as *.vercel.app to
# admit preview deployments, or * to allow any origin (demos only).
CORS_ORIGINS=http://localhost:5173

# --- Postgres ---------------------------------------------------------------
# Credentials used by docker-compose to provision the container
POSTGRES_USER=asset
POSTGRES_PASSWORD=asset_dev_password
POSTGRES_DB=asset_management
POSTGRES_PORT=5442
POSTGRES_TEST_PORT=5443
# Connection string used by Prisma. Must match the values above.
DATABASE_URL=postgresql://asset:asset_dev_password@localhost:5442/asset_management?schema=public
# Connection string used by the integration test suite (separate database)
TEST_DATABASE_URL=postgresql://asset:asset_dev_password@localhost:5443/asset_management_test?schema=public

# --- Redis (BullMQ scheduled jobs) -----------------------------------------
# Unused until the scheduled alerts in phase 7; nothing connects to it yet.
REDIS_HOST=localhost
REDIS_PORT=6389
# Leave empty when the local Redis has no password
REDIS_PASSWORD=

# --- Object storage (MinIO locally, any S3-compatible endpoint in cloud) ----
# OPTIONAL until invoice uploads land in phase 4 — the API boots without these.
# Endpoint URL. Leave unset in AWS to use the region's default endpoint.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=asset-management
# MinIO requires path-style addressing; AWS S3 does not.
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011

# --- Auth -------------------------------------------------------------------
# Secret signing the 15-minute access tokens. Minimum 32 characters.
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# Secret signing the 7-day refresh tokens. Must differ from the access secret.
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string_32_chars
# Token lifetimes, as ms-style durations
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# true renders human-readable logs via pino-pretty; false emits raw JSON
LOG_PRETTY=true

# --- Seed -------------------------------------------------------------------
# Password given to every seeded app user. Development only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# --- Frontend (apps/web, read at build time by Vite) ------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
