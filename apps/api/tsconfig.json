{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "declarationMap": false,
    // Inside dist so `nest build`'s deleteOutDir clears it too. Left outside,
    // a stale cache makes tsc skip files it has already "emitted" into a
    // directory that no longer exists.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "prisma/seed.ts"]
}
